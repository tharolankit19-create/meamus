# ---------------------------------------------------------------------------
# meamus configuration
# Copy to .env  ->  cp .env.example .env
#
# The ONLY value you must fill in is OPENROUTER_API_KEY.
# Without it the app still runs fully in TEMPLATE MODE (a deterministic
# generator backed by the bundled demo templates).
#
# After adding the key, verify it with:  npm run llm:check
# ---------------------------------------------------------------------------

# --- Model (the one thing you need to add) --------------------------------
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Default: NVIDIA Nemotron 3 Super 120B on the FREE tier. 262k context, 235k
# max output, and it honours structured outputs.
#
# That last point is why this one and not another free model. With a schema the
# model is held to the GameSpec shape; without one it answers with prose around
# the JSON and the spec has to be scraped back out, which is where malformed
# games come from. Of the free NVIDIA models, only this one supports schemas:
#
#   nvidia/nemotron-3-super-120b-a12b:free   schema ✓   262k ctx   235k out
#   nvidia/nemotron-3-ultra-550b-a55b:free   schema ✗     1M ctx    65k out
#   nvidia/nemotron-3.5-lightning:free       schema ✗     1M ctx    65k out
#   nvidia/nemotron-3-nano-omni-30b:free     schema ✗   256k ctx    65k out
#
# The free tier is RATE LIMITED per minute and per day, and one build is three
# to five model calls (designer, coder, reviewer, and the repair/improve rounds
# when they are needed). Expect to hit the cap on a busy day. When you do, the
# same model paid is about $0.09/M in + $0.40/M out:
#
#   OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b
#
# Note the paid tier of this model caps output at 16k tokens against the free
# tier's 235k. A whole game is a big document, so if you switch and builds start
# coming back truncated, that ceiling is why - not the model.
#
# It is also a REASONING model, and reasoning tokens are spent out of max_tokens
# before the answer starts. meamus turns reasoning off for that reason (these
# calls return a schema-pinned JSON document and the thinking is discarded).
# Set LLM_REASONING=low|medium|high to turn it back on, and raise
# LLM_MAX_TOKENS with it or the answer gets cut off.
#
# Anything on https://openrouter.ai/models works. meamus reads the catalogue at
# startup and adapts: no schema support means it falls back to parsing the JSON
# out of the reply, and a text-only model gets told what an attached image was
# rather than being sent one.
#
# LEAVING THIS UNSET IS USUALLY BETTER. meamus keeps a roster of free models per
# job (see server/services/models.js) and walks it: when a model is rate
# limited, capped for the day, or 500ing, the next one is asked instead, and the
# one that refused is skipped for the rest of the build. Setting this pins one
# model to the FRONT of that roster - it is asked first, every time - but the
# rest still follow it as fallback, because "the model you chose is busy" is not
# a reason to have no product. Set it when you want a specific model; unset it
# when you want the build to finish.
# OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Shown on OpenRouter's dashboard and leaderboards. Cosmetic.
OPENROUTER_REFERER=https://meamus.app
OPENROUTER_TITLE=meamus

# Shared across providers.
LLM_MAX_TOKENS=32000
LLM_TEMPERATURE=0.6
LLM_TIMEOUT_MS=300000
# Reasoning effort on models that support it. Off unless set, because reasoning
# tokens come out of LLM_MAX_TOKENS before the answer is written.
# LLM_REASONING=low

# Optional: force a provider. Otherwise whichever key is set wins,
# with OpenRouter taking precedence.
# LLM_PROVIDER=openrouter
#
# The Anthropic path still works if that is the key you have:
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5

# --- The build crew ---------------------------------------------------------
# Optional for free models; enabled by default for other models. The crew runs as:
#
#   Designer  decides the genre, core loop, mechanics and fail state
#   Coder     writes the game to that brief
#   Tester    boots every scene and ticks it (not a model - it actually runs)
#   Reviewer  reads the code back as a critic
#   Improver  applies what the reviewer found, then the Tester runs again
#
# That is three to five model calls instead of one, so a build costs more and
# takes longer. It also stops the single call from having to design, write and
# critique a whole game in one breath, which is where the weak ones came from.
# Set to false for the old single-call path.
# Free models default to the single-call build/repair path.
# Set true only to explicitly enable additional designer/reviewer calls.
# AGENT_CREW=false
#
# How many times a build that will not boot is handed back with the reason.
# BUILD_MAX_ATTEMPTS=3

# --- Access -----------------------------------------------------------------
# An account is required to build, and an account has no limits. The landing
# page's demo game stays public so a visitor can see the product working
# before signing up.

# Leave both unset for the automatic model: an account is required when
# storage can hold one, and access opens by itself when it cannot - because
# requiring a login that is impossible to complete leaves a dead site.
#
# OPEN_ACCESS=true lets visitors build with no account at all.
# WARNING: with a model key set that lets anyone on the internet spend your
# API credits without signing up. Only set it deliberately.
# OPEN_ACCESS=

# TEMPLATE_ACCESS=gated needs an account for the library, apart from the
# showcase template that runs the landing demo. "open" frees them all.
# TEMPLATE_ACCESS=

# UNLIMITED_GENERATIONS: no daily cap for signed-in users. Default: true.
# Set to false to enforce the per-plan quotas below instead.
UNLIMITED_GENERATIONS=true

TEST_MODE=true

# --- Server ---------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# --- Auth -----------------------------------------------------------------
# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# If left empty a random secret is generated at boot (sessions reset on restart).
JWT_SECRET=
JWT_TTL_HOURS=168

# --- Credits --------------------------------------------------------------
# Credits are the real meter. A generation costs the operator money at the
# model provider, so every account gets a starting grant and plans top it up.
# Set CREDITS=false to switch the whole system off and fall back to the daily
# quotas below.
CREDITS=true
# What a new account starts with. 200 buys about ten games at the defaults.
SIGNUP_CREDITS=200
# A game built from nothing costs more than a change to an existing one.
CREDITS_PER_GAME=20
CREDITS_PER_EDIT=10

# --- Quotas (only applied when UNLIMITED_GENERATIONS=false) ---------------
GUEST_DAILY_GENERATIONS=20
FREE_DAILY_GENERATIONS=5
PRO_DAILY_GENERATIONS=200
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# --- Billing (stub) -------------------------------------------------------
# Leave BILLING_PROVIDER=stub to use the built-in fake checkout.
# Set to "stripe" and fill the keys to wire real payments (see docs/BILLING.md).
BILLING_PROVIDER=stub
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# --- Storage --------------------------------------------------------------
# Leave the Supabase values empty to store to a local JSON file (fine locally,
# WIPED ON EVERY RESTART on an ephemeral or serverless host - which shows up as
# "signup stopped working").
#
# To use Postgres instead:
#   1. Run supabase/schema.sql in the Supabase SQL editor
#   2. Fill both values below (Dashboard -> Project Settings -> API)
#   3. Verify with: npm run db:check
#
# SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security. Keep it server-side
# only - never ship it to a browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

DATA_DIR=./server/data

# --- Design research --------------------------------------------------------
# Generation is grounded in real games from the FreeToGame catalogue
# (https://www.freetogame.com). No key or account is required, and attribution
# is rendered in the footer as their terms require. It supplies genre metadata
# and prose, not code or physics.

# --- Templates ------------------------------------------------------------
# The one template anyone can play without an account. It runs the landing
# page's self-playing demo, so it has to stay public.
SHOWCASE_TEMPLATE=space-shooter
