# ---------------------------------------------------------------------------
# meamus configuration
# Copy to .env  ->  cp .env.example .env
#
# The ONLY value you must fill in for AI generation is ANTHROPIC_API_KEY.
# Without it the app still runs fully in TEMPLATE MODE (deterministic
# generator backed by the bundled demo templates).
# ---------------------------------------------------------------------------

# --- Claude API (the one thing you need to add) ---------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MAX_TOKENS=16000
ANTHROPIC_BASE_URL=https://api.anthropic.com

# --- Server ---------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# --- Auth -----------------------------------------------------------------
# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# If left empty a random secret is generated at boot (sessions reset on restart).
JWT_SECRET=
JWT_TTL_HOURS=168

# --- Quotas ---------------------------------------------------------------
FREE_DAILY_GENERATIONS=5
PRO_DAILY_GENERATIONS=200
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# --- Billing (stub) -------------------------------------------------------
# Leave BILLING_PROVIDER=stub to use the built-in fake checkout.
# Set to "stripe" and fill the keys to wire real payments (see docs/BILLING.md).
BILLING_PROVIDER=stub
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# --- Storage --------------------------------------------------------------
DATA_DIR=./server/data
